{
  "scripts": {
    "build:favicon": "node scripts/build-favicon.js",
    "build:assets": "npx clean-css-cli -o css/styles.min.css css/styles.css && npx terser js/script.js -c -m -o js/script.min.js",
    "fingerprint": "node -e \"const c=require('crypto'),fs=require('fs'),p=require('path');const r=process.cwd();const b=fs.readFileSync(p.join(r,'css/fonts.css'),'utf8')+'\\n'+fs.readFileSync(p.join(r,'css/styles.min.css'),'utf8');console.log('css/app.bundle',c.createHash('sha256').update(b).digest('hex').slice(0,8));['css/styles.min.css','js/script.min.js'].forEach(f=>console.log(f,c.createHash('sha256').update(fs.readFileSync(f)).digest('hex').slice(0,8)));\"",
    "sync-fingerprinted": "node scripts/fingerprint-assets.js",
    "build:release": "npm run build:assets && npm run sync-fingerprinted"
  },
  "dependencies": {
    "firebase": "^12.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "clean-css-cli": "^5.6.3",
    "sharp": "^0.34.4",
    "terser": "^5.44.0",
    "to-ico": "^1.1.5"
  }
}
