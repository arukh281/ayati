{
  "scripts": {
    "build:assets": "npx clean-css-cli -o css/styles.min.css css/styles.css && npx terser js/script.js -c -m -o js/script.min.js",
    "fingerprint": "node -e \"const c=require('crypto'),fs=require('fs');['css/styles.min.css','js/script.min.js','css/fonts.css'].forEach(f=>{const h=c.createHash('sha256').update(fs.readFileSync(f)).digest('hex').slice(0,8);console.log(f,h);});\"",
    "sync-fingerprinted": "node -e \"const c=require('crypto'),fs=require('fs');const h=p=>c.createHash('sha256').update(fs.readFileSync(p)).digest('hex').slice(0,8);const ch=h('css/styles.min.css'),jh=h('js/script.min.js'),fh=h('css/fonts.css');fs.copyFileSync('css/styles.min.css','css/styles.'+ch+'.min.css');fs.copyFileSync('js/script.min.js','js/script.'+jh+'.min.js');fs.copyFileSync('css/fonts.css','css/fonts.'+fh+'.css');console.log('css/styles.'+ch+'.min.css','js/script.'+jh+'.min.js','css/fonts.'+fh+'.css');\""
  },
  "dependencies": {
    "firebase": "^12.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "clean-css-cli": "^5.6.3",
    "terser": "^5.44.0"
  }
}
